# Salin ke .env lalu sesuaikan. JANGAN commit .env.

# --- Aplikasi ---
ZANDAR_ENV=dev
JWT_SECRET=ganti-dengan-string-acak-panjang
JWT_ACCESS_TTL_MINUTES=60
JWT_REFRESH_TTL_DAYS=7

# --- PostgreSQL (sumber kebenaran) ---
DATABASE_URL=postgresql+asyncpg://zandar:zandar@127.0.0.1:5433/zandar

# --- Redis (queue Celery + cache) ---
REDIS_URL=redis://127.0.0.1:6380/0

# --- Qdrant (vector store) — dipakai mulai Fase 2 ---
QDRANT_URL=http://127.0.0.1:6335

# --- Neo4j (knowledge graph) — dipakai mulai Fase 3 ---
NEO4J_URI=bolt://127.0.0.1:7688
NEO4J_USER=neo4j
NEO4J_PASSWORD=zandarneo4j

# --- MinIO (raw data lake) ---
MINIO_ENDPOINT=127.0.0.1:9002
MINIO_ACCESS_KEY=zandar
MINIO_SECRET_KEY=zandarminio
MINIO_BUCKET_RAW=raw

# --- Pseudonimisasi author (UU PDP) — ganti dengan string acak panjang ---
AUTHOR_HASH_SALT=ganti-salt-acak-panjang

# --- Kredensial sumber (Fase 1) ---
YOUTUBE_API_KEY=
GITHUB_TOKEN=
# X berbayar per post dibaca (~$0.005). Kosongkan bila belum berlangganan.
X_BEARER_TOKEN=
# BPS WebAPI (ground truth resmi) — daftar gratis di https://webapi.bps.go.id/developer/
BPS_TOKEN=

# --- LLM providers (Fase 2; kosongkan dulu) ---
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Klasifikasi (Fase 2) ---
# lexicon (default, tanpa GPU) | indobert (butuh pip install -e ".[ml]") | flash (API)
CLASSIFIER_PROVIDER=lexicon
INDOBERT_SENTIMENT_MODEL=w11wo/indonesian-roberta-base-sentiment-classifier

# --- Embedding (Fase 2) → Qdrant ---
# stub (default, plumbing) | gemini (gratis, token-based, isi GEMINI_API_KEY) | local (e5-small)
EMBED_PROVIDER=stub
EMBED_MODEL=
QDRANT_COLLECTION=comments_v1

# --- Orkestrasi LangGraph (Fase 2) ---
# stub (default, tanpa API key) | groq | gemini | cerebras | openrouter
# Daftar salah satu (gratis): Groq https://console.groq.com | Gemini https://aistudio.google.com
LLM_PROVIDER=stub
# Kosongkan model = pakai default preset provider (mis. groq: llama-3.3-70b / llama-3.1-8b)
LLM_MODEL_R=
LLM_MODEL_F=
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# --- Observability (profile: observability) ---
LANGFUSE_HOST=http://127.0.0.1:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
