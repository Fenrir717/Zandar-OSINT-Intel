# .env.production — SALIN ke .env sebelum deploy: `cp .env.production.example .env`
# JANGAN commit .env asli (sudah di-gitignore).
#
# CATATAN PENTING: URL infra (DATABASE_URL/REDIS_URL/QDRANT_URL/NEO4J_URI/MINIO_ENDPOINT)
# DITIMPA OTOMATIS oleh docker-compose.deploy.yml ke nama-service (postgres/redis/...).
# Tak perlu diisi di sini untuk deploy Docker — biarkan default/boleh dikosongkan.

ZANDAR_ENV=production

# === WAJIB GANTI (keamanan) — pakai string acak panjang (≥32 char) ===
JWT_SECRET=__ganti_string_acak_panjang_min_32_char__
AUTHOR_HASH_SALT=__ganti_salt_acak_panjang__

# === Admin pertama — seed idempoten saat container `app` start ===
# Kosongkan ADMIN_PASSWORD = seed dilewati (buat manual: docker compose exec app python scripts/create_admin.py --email .. --password ..)
ADMIN_EMAIL=admin@zandar.local
ADMIN_PASSWORD=__ganti_password_kuat__
ADMIN_NAME=Admin

# === Kredensial infra ===
# Default (zandar/zandar, dst) diset di docker-compose.yml. Kalau mau lebih aman,
# ganti di docker-compose.yml DAN samakan override URL di docker-compose.deploy.yml.

# === Kunci sumber (opsional; isi sesuai kebutuhan) ===
YOUTUBE_API_KEY=
GITHUB_TOKEN=
X_BEARER_TOKEN=
BPS_TOKEN=

# === Klasifikasi & LLM (default baseline tanpa GPU/tanpa key) ===
CLASSIFIER_PROVIDER=lexicon
EMBED_PROVIDER=stub
LLM_PROVIDER=stub
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=ap-southeast-3
BEDROCK_MODEL_R=
BEDROCK_MODEL_F=

# === Alert Early Warning (opsional) ===
TELEGRAM_ALERT_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ALERT_EMAIL_TO=

# === Adapter Telegram (koleksi channel publik, MTProto) ===
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# Daftar lengkap variabel: lihat .env.example
